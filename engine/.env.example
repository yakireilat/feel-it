# Copy to .env and fill in. Never commit .env.
PORT=8080
ADMIN_TOKEN=change-me-long-random-string

# One webhook secret per client, named by the client's "webhookSecretEnv".
SECRET_DEMO_BARBER=change-me-too
SECRET_FEEL_IT_DEMO=change-me-three

# WhatsApp Cloud API (Meta). Leave WHATSAPP_TOKEN empty to run in dry-run mode (messages are only logged).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DRY_RUN=0
# Incoming messages (opt-out, owner approvals, customer replies): Meta webhook -> https://<engine>/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=

# Public address of this engine, for tracked booking links in missed-call messages (e.g. https://engine.feelit.co.il).
PUBLIC_URL=

# Google Business Profile (fetch reviews, post approved replies). One refresh token per client, named by its google.refreshTokenEnv.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Our team's phone for failure alerts.
OPS_PHONE=

# Claude for review-reply drafts. Without a key, fixed template replies are used.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

RETENTION_DAYS=180
