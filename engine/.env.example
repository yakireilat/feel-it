# Copy to .env and fill in. Never commit .env.
PORT=8080
ADMIN_TOKEN=change-me-long-random-string

# One webhook secret per client, named by the client's "webhookSecretEnv".
SECRET_DEMO_BARBER=change-me-too

# WhatsApp Cloud API (Meta). Leave WHATSAPP_TOKEN empty to run in dry-run mode (messages are only logged).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DRY_RUN=0

# Our team's phone for failure alerts.
OPS_PHONE=

# Claude for review-reply drafts. Without a key, fixed template replies are used.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

RETENTION_DAYS=180
